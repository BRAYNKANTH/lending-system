# Copy this file to .env.local for local development, and set the same
# keys in Vercel Project Settings -> Environment Variables for production.

# Postgres connection string (Supabase "Connection pooling" URI recommended for serverless)
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:6543/postgres

# Secret used to sign JWTs. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Shared secret the Vercel Cron job must send to trigger interest accrual.
# Generate the same way as JWT_SECRET.
CRON_SECRET=
