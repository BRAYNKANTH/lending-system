# Copy this file to .env.local for local development, and set the same
# keys in Vercel Project Settings -> Environment Variables for production.

# Postgres connection string (Supabase "Connection pooling" URI recommended for serverless)
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:6543/postgres

# Secret used to sign JWTs. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Shared secret the Vercel Cron jobs must send to trigger interest accrual
# and payment reminders. Generate the same way as JWT_SECRET.
CRON_SECRET=

# Text.lk SMS gateway (https://text.lk) — used for all borrower/admin SMS
# notifications, payment reminders, and missed-payment alerts. Leave both
# blank to fall back to console-only mock SMS (useful for local dev without
# a Text.lk account/cost). Get the API token from your Text.lk dashboard;
# the sender ID must be one Text.lk has approved for your account (see the
# authorization letter you send them to register it).
TEXTLK_API_TOKEN=
TEXTLK_SENDER_ID=
